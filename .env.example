# ── Publiczne (trafiają do przeglądarki) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tryb demo: formularz informuje, że zgłoszenie trafia do testowej skrzynki. `false` na prawdziwym wdrożeniu.
NEXT_PUBLIC_DEMO_MODE=true
# Klucz testowy Cloudflare - zawsze przechodzi. Puste = brak widgetu (lokalnie, e2e).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Kalendarze konsultacji: <base>/<slug-księgowej>/konsultacja. Puste = konsultacja przez formularz.
NEXT_PUBLIC_CAL_BASE_URL=
# Statystyki Umami bez cookies. Puste = brak statystyk.
NEXT_PUBLIC_UMAMI_HOST=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Tylko serwer ──────────────────────────────────────────────────────────
# Sanity (projekt xh2t6pff). Bez SANITY_PROJECT_ID treści pochodzą z src/content/fixtures (podglądy, testy).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
# Dataset jest prywatny: token z rolą viewer (sanity.io/manage → API → Tokens). Bez niego strona używa danych lokalnych.
SANITY_API_READ_TOKEN=
# Sekret webhooka Sanity → /api/revalidate (rewalidacja po typie dokumentu).
SANITY_REVALIDATE_SECRET=

# Supabase. Bez nich `next dev` trzyma leady w pamięci, a build produkcyjny zwraca 503 (ADR-005).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# `memory` - leady w pamięci także w buildzie (e2e, podgląd). Nigdy na produkcji.
LEAD_STORE=

# Klucz testowy Cloudflare - zawsze przechodzi. Na produkcji wymagany.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# n8n: webhook `lead.created`, podpis HMAC-SHA256 (src/server/webhook.ts).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
